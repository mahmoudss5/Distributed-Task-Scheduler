# Copy this file to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-32-byte-secret
HEALTH_TOKEN=replace-with-a-separate-random-token

DB_HOST=localhost
DB_PORT=3306
DB_USER=taskflow
DB_PASSWORD=change-me
DB_NAME=taskflow
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=taskflow-api
KAFKA_GROUP_ID=taskflow-workers
KAFKA_DLQ_TOPIC=job-dlq

EMAIL_USER=your-gmail-address@example.com
EMAIL_APP_PASSWORD=your-gmail-app-password
REPORTS_DIR=./reports
